  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/sri-lanka-map.git"
  },
  "keywords": [
    "react",
    "map",
    "sri-lanka",
    "districts",
    "visualization"
  ],
  "type": "module",
  "source": "src/index.js",
  "main": "dist/sri-lanka-map.cjs",
  "module": "dist/sri-lanka-map.module.js",
  "unpkg": "dist/sri-lanka-map.umd.js",
